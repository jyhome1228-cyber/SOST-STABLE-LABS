rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'planus253@naver.com';
    }

    function validInquiryCreate() {
      return request.resource.data.keys().hasOnly([
          'company', 'name', 'email', 'phone', 'projectType',
          'schedule', 'budget', 'website', 'message',
          'privacyAgreed', 'status', 'adminMemo', 'source',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.company is string
        && request.resource.data.company.size() > 0
        && request.resource.data.company.size() <= 120
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 160
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 60
        && request.resource.data.projectType is string
        && request.resource.data.projectType.size() > 0
        && request.resource.data.projectType.size() <= 500
        && request.resource.data.schedule is string
        && request.resource.data.schedule.size() <= 120
        && request.resource.data.budget is string
        && request.resource.data.budget.size() <= 100
        && request.resource.data.website is string
        && request.resource.data.website.size() <= 300
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.privacyAgreed == true
        && request.resource.data.status == 'new'
        && request.resource.data.adminMemo == ''
        && request.resource.data.source is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validVisitorCreate(visitorId) {
      return request.resource.data.keys().hasOnly([
          'visitorId', 'firstSeenAt', 'lastSeenAt', 'firstPath',
          'lastPath', 'lastVisitDate', 'pageViews'
        ])
        && request.resource.data.visitorId == visitorId
        && request.resource.data.visitorId is string
        && request.resource.data.visitorId.size() >= 16
        && request.resource.data.visitorId.size() <= 80
        && request.resource.data.firstSeenAt == request.time
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.firstPath is string
        && request.resource.data.firstPath.size() <= 300
        && request.resource.data.lastPath is string
        && request.resource.data.lastPath.size() <= 300
        && request.resource.data.lastVisitDate is string
        && request.resource.data.lastVisitDate.size() == 10
        && request.resource.data.pageViews == 1;
    }

    function validVisitorUpdate(visitorId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastSeenAt', 'lastPath', 'lastVisitDate', 'pageViews'
        ])
        && request.resource.data.visitorId == visitorId
        && request.resource.data.visitorId == resource.data.visitorId
        && request.resource.data.firstSeenAt == resource.data.firstSeenAt
        && request.resource.data.firstPath == resource.data.firstPath
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.lastPath is string
        && request.resource.data.lastPath.size() <= 300
        && request.resource.data.lastVisitDate is string
        && request.resource.data.lastVisitDate.size() == 10
        && request.resource.data.pageViews == resource.data.pageViews + 1;
    }

    function validDailyCreate(dateId) {
      return request.resource.data.keys().hasOnly(['date', 'views', 'updatedAt'])
        && request.resource.data.date == dateId
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.views == 1
        && request.resource.data.updatedAt == request.time;
    }

    function validDailyUpdate(dateId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'updatedAt'])
        && request.resource.data.date == dateId
        && request.resource.data.date == resource.data.date
        && request.resource.data.views == resource.data.views + 1
        && request.resource.data.updatedAt == request.time;
    }

    match /inquiries/{inquiryId} {
      allow create: if validInquiryCreate();
      allow read, update, delete: if isAdmin();
    }

    match /traffic_visitors/{visitorId} {
      allow create: if validVisitorCreate(visitorId);
      allow update: if validVisitorUpdate(visitorId);
      allow read, delete: if isAdmin();
    }

    match /traffic_daily/{dateId} {
      allow create: if validDailyCreate(dateId);
      allow update: if validDailyUpdate(dateId);
      allow read, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
